{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aew.local/schemas/0.2/execution.schema.json",
  "title": "AEW Execution Envelope 0.2",
  "description": "AEW 0.2 execution wire contract. Runtime authority requires trusted engine validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "work_unit_id",
    "plan_revision",
    "context",
    "authorization",
    "workspace",
    "scope",
    "budget",
    "verification",
    "delivery",
    "state",
    "observation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "$ref": "#/$defs/contextBinding"
    },
    "authorization": {
      "$ref": "#/$defs/authorizationBinding"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "observation": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/observation"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "parent_execution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "child_authority_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sandbox_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "runtime_approval_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "accounting_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "agent_counts": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/agent_counts"
    },
    "application_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "requirements_digest",
        "verification_ids",
        "review_ids"
      ],
      "properties": {
        "candidate": {
          "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/candidate"
        },
        "requirements_digest": {
          "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/digest"
        },
        "verification_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "review_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "snapshot_id"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "require_freshness": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "authorizationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "required_operations"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "required_operations": {
          "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/operations"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "baseline_commit",
        "workspace_id",
        "expected_fingerprint"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "protected_paths",
        "preserve_unrelated_changes"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserve_unrelated_changes": {
          "const": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "max_duration_seconds",
        "on_exhaustion",
        "max_tool_calls"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "on_exhaustion": {
          "const": "suspend"
        },
        "progress_check": {
          "enum": [
            "every_iteration",
            "on_failure",
            "on_checkpoint"
          ],
          "default": "on_failure"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_checks",
        "require_evidence"
      ],
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationCheck"
          }
        },
        "require_evidence": {
          "const": true
        },
        "stop_on_failure": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "expected_outcome": {
          "type": "string"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare_commit",
        "execute_commit",
        "push",
        "create_pr",
        "merge"
      ],
      "properties": {
        "prepare_commit": {
          "type": "boolean"
        },
        "execute_commit": {
          "type": "boolean",
          "default": false
        },
        "push": {
          "type": "boolean",
          "default": false
        },
        "create_pr": {
          "type": "boolean",
          "default": false
        },
        "merge": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "iteration"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "running",
            "verifying",
            "suspended",
            "completed"
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "not_determined"
          ]
        },
        "last_checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "suspension_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "assignment_id"
        ],
        "properties": {}
      },
      "then": {
        "required": [
          "parent_execution_id",
          "child_authority_id",
          "sandbox_id",
          "capability_id",
          "runtime_approval_id",
          "accounting_id",
          "agent_counts"
        ]
      }
    },
    {
      "if": {
        "required": [
          "authorization"
        ],
        "properties": {
          "authorization": {
            "properties": {
              "required_operations": {
                "contains": {
                  "const": "delegate"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "agent_counts",
          "accounting_id"
        ]
      }
    },
    {
      "if": {
        "required": [
          "authorization"
        ],
        "properties": {
          "authorization": {
            "properties": {
              "required_operations": {
                "contains": {
                  "const": "apply_candidate"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "application_gate"
        ],
        "properties": {
          "observation": {
            "properties": {
              "kind": {
                "const": "candidate"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "delivery"
        ],
        "properties": {
          "delivery": {
            "properties": {
              "prepare_commit": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "execute_commit": {
                "const": false
              },
              "push": {
                "const": false
              },
              "create_pr": {
                "const": false
              },
              "merge": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "parent_execution_id"
        ]
      },
      "then": {
        "required": [
          "assignment_id",
          "parent_execution_id",
          "child_authority_id",
          "sandbox_id",
          "capability_id",
          "runtime_approval_id",
          "accounting_id",
          "agent_counts"
        ]
      }
    },
    {
      "if": {
        "required": [
          "child_authority_id"
        ]
      },
      "then": {
        "required": [
          "assignment_id",
          "parent_execution_id",
          "child_authority_id",
          "sandbox_id",
          "capability_id",
          "runtime_approval_id",
          "accounting_id",
          "agent_counts"
        ]
      }
    },
    {
      "if": {
        "required": [
          "sandbox_id"
        ]
      },
      "then": {
        "required": [
          "assignment_id",
          "parent_execution_id",
          "child_authority_id",
          "sandbox_id",
          "capability_id",
          "runtime_approval_id",
          "accounting_id",
          "agent_counts"
        ]
      }
    },
    {
      "if": {
        "required": [
          "capability_id"
        ]
      },
      "then": {
        "required": [
          "assignment_id",
          "parent_execution_id",
          "child_authority_id",
          "sandbox_id",
          "capability_id",
          "runtime_approval_id",
          "accounting_id",
          "agent_counts"
        ]
      }
    },
    {
      "if": {
        "required": [
          "runtime_approval_id"
        ]
      },
      "then": {
        "required": [
          "assignment_id",
          "parent_execution_id",
          "child_authority_id",
          "sandbox_id",
          "capability_id",
          "runtime_approval_id",
          "accounting_id",
          "agent_counts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {
              "required_operations": {
                "contains": {
                  "const": "review"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {
              "kind": {
                "const": "candidate"
              }
            }
          }
        }
      }
    }
  ]
}
