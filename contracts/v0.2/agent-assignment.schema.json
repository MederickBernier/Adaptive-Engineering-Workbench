{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aew.local/schemas/0.2/agent-assignment.schema.json",
  "title": "AEW 0.2 Agent Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "request_id",
    "task_id",
    "plan_revision",
    "work_unit_id",
    "parent_execution_id",
    "profile_id",
    "profile_revision",
    "role_id",
    "role_revision",
    "context_id",
    "snapshot_id",
    "repository",
    "observation",
    "child_authority_id",
    "sandbox_id",
    "capability_id",
    "runtime_approval_id",
    "accounting_id",
    "operations",
    "allowed_paths",
    "protected_paths",
    "budget",
    "agent_counts",
    "specializations",
    "dependencies",
    "access_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "parent_execution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "observation": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/observation"
    },
    "child_authority_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sandbox_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "runtime_approval_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "accounting_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operations": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/operations"
    },
    "allowed_paths": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/paths"
    },
    "protected_paths": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/paths"
    },
    "budget": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/limits"
    },
    "agent_counts": {
      "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/agent_counts"
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "basis",
          "evidence_references"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "access_mode": {
      "enum": [
        "read_only",
        "scoped_write"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "access_mode"
        ],
        "properties": {
          "access_mode": {
            "const": "read_only"
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "investigate",
                "review"
              ]
            }
          }
        }
      }
    }
  ]
}
