{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aew.local/schemas/0.2/task.schema.json",
  "title": "AEW Task Contract 0.2",
  "description": "AEW 0.2 task wire contract. Runtime authority requires trusted engine validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "assessment",
    "plan",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "task": {
      "$ref": "#/$defs/taskIdentity"
    },
    "assessment": {
      "$ref": "#/$defs/assessment"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "default": []
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "$defs": {
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "repository",
        "objective"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "github",
            "local"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "rationale",
        "risk",
        "uncertainty"
      ],
      "properties": {
        "profile": {
          "enum": [
            "quick",
            "standard",
            "deep",
            "explore"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "uncertainty": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "verification"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "provisional",
            "stale",
            "disputed"
          ]
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "branch",
        "commit",
        "workspace"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "warning",
            "blocked",
            "unavailable"
          ]
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "workspace": {
          "enum": [
            "clean",
            "dirty_non_overlapping",
            "dirty_overlapping",
            "unknown"
          ]
        },
        "proposed_branch": {
          "type": "string"
        },
        "relevant_prs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "default": []
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "approach",
        "work_units",
        "verification"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "approach": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "work_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workUnit"
          },
          "default": []
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "delegation": {
          "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/agent_counts"
        }
      }
    },
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "scope",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "commit_required": {
          "type": "boolean",
          "default": true
        },
        "requirements": {
          "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/requirements"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_actions"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "required_actions": {
          "type": "array",
          "items": {
            "$ref": "https://aew.local/schemas/0.2/common.schema.json#/$defs/operation"
          },
          "uniqueItems": true
        },
        "grant_id": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "approval"
        ],
        "properties": {
          "approval": {
            "properties": {
              "required_actions": {
                "contains": {
                  "const": "delegate"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "required": [
              "delegation"
            ]
          }
        }
      }
    }
  ]
}
