
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aew.local/schemas/execution.schema.json",
  "title": "AEW Execution Envelope",
  "description": "Bounded execution contract for one AEW Work Unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "work_unit_id",
    "plan_revision",
    "context",
    "authorization",
    "workspace",
    "scope",
    "budget",
    "verification",
    "delivery",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "$ref": "#/$defs/contextBinding"
    },
    "authorization": {
      "$ref": "#/$defs/authorizationBinding"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "state": {
      "$ref": "#/$defs/state"
    }
  },
  "$defs": {
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "snapshot_id"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "require_freshness": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "authorizationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "required_operations"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "required_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "investigate",
              "implement",
              "run_tests",
              "create_branch",
              "stage",
              "commit",
              "push",
              "create_pr",
              "merge"
            ]
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "baseline_commit",
        "workspace_id",
        "expected_fingerprint"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "protected_paths",
        "preserve_unrelated_changes"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserve_unrelated_changes": {
          "const": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "max_duration_seconds",
        "on_exhaustion"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "on_exhaustion": {
          "const": "suspend"
        },
        "progress_check": {
          "enum": [
            "every_iteration",
            "on_failure",
            "on_checkpoint"
          ],
          "default": "on_failure"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_checks",
        "require_evidence"
      ],
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationCheck"
          }
        },
        "require_evidence": {
          "const": true
        },
        "stop_on_failure": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": ["string", "null"]
        },
        "required": {
          "type": "boolean"
        },
        "expected_outcome": {
          "type": "string"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare_commit",
        "execute_commit",
        "push",
        "create_pr",
        "merge"
      ],
      "properties": {
        "prepare_commit": {
          "const": true
        },
        "execute_commit": {
          "type": "boolean",
          "default": false
        },
        "push": {
          "type": "boolean",
          "default": false
        },
        "create_pr": {
          "type": "boolean",
          "default": false
        },
        "merge": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "iteration"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "running",
            "verifying",
            "suspended",
            "completed"
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "incomplete",
            "not_determined"
          ]
        },
        "last_checkpoint_id": {
          "type": ["string", "null"]
        },
        "suspension_reason": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
