
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aew.local/schemas/context.schema.json",
  "title": "AEW Context Package",
  "description": "Revision-scoped engineering knowledge contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "identity",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_package_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "knowledge": {
      "$ref": "#/$defs/knowledge"
    },
    "coordination": {
      "$ref": "#/$defs/coordination"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      },
      "default": []
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "repository",
        "revision"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "snapshot_id"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_fingerprint": {
          "type": ["string", "null"]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "coverage",
        "limitations"
      ],
      "properties": {
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "complete_for_scope",
            "partial",
            "unknown"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discovery_depth": {
          "enum": [
            "unknown",
            "light",
            "standard",
            "deep",
            "mixed"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conventions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeReference"
          }
        },
        "verification_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationCommand"
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeReference"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "enum": [
            "unknown",
            "light",
            "standard",
            "deep"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knowledgeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "normative",
            "approved",
            "informational"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "relevance",
        "authority",
        "verification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "relevance": {
          "enum": [
            "direct",
            "related",
            "supporting"
          ]
        },
        "authority": {
          "enum": [
            "normative",
            "approved",
            "informational"
          ]
        },
        "verification": {
          "enum": [
            "source_verified",
            "test_verified",
            "provisional",
            "stale",
            "disputed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reference"
      ],
      "properties": {
        "source": {
          "enum": [
            "repository",
            "github",
            "vault",
            "test",
            "manual"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "verificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "evidence"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relevant_prs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pullRequest"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "severity",
        "reason"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "severity": {
          "enum": [
            "informational",
            "potential",
            "blocking"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "relationship"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "requires",
            "affects",
            "related"
          ]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "blocking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
