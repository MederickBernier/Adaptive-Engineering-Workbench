
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aew.local/schemas/approval.schema.json",
  "title": "AEW Approval Grant",
  "description": "Scoped authorization contract for AEW v0.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "task_id",
    "plan_revision",
    "workspace",
    "status",
    "authorization",
    "scope",
    "constraints",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "status": {
      "enum": [
        "pending",
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "revocation_reason": {
      "type": ["string", "null"]
    },
    "approved_by": {
      "$ref": "#/$defs/approver"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "baseline_commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        },
        "workspace_id": {
          "type": ["string", "null"]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "investigate",
              "implement",
              "run_tests",
              "create_branch",
              "stage",
              "commit",
              "push",
              "create_pr",
              "merge"
            ]
          }
        },
        "autonomy_level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "default": "L1"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "protected_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_unrelated_changes",
        "allow_public_api_changes",
        "allow_database_migrations",
        "allow_new_dependencies",
        "allow_destructive_operations"
      ],
      "properties": {
        "preserve_unrelated_changes": {
          "const": true
        },
        "allow_public_api_changes": {
          "type": "boolean",
          "default": false
        },
        "allow_database_migrations": {
          "type": "boolean",
          "default": false
        },
        "allow_new_dependencies": {
          "type": "boolean",
          "default": false
        },
        "allow_destructive_operations": {
          "type": "boolean",
          "default": false
        },
        "additional_restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "source"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "local_user",
            "repository_policy",
            "organization_policy"
          ]
        }
      }
    }
  }
}
